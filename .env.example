# Copie para .env (o docker compose lê automaticamente).
# Por padrão o projeto roda SEM LLM e sem custo.
LLM_HABILITADO=false
ANTHROPIC_API_KEY=

# Porta do Postgres no host (para psql/DBeaver). A 5432 costuma estar ocupada.
POSTGRES_HOST_PORT=5435

# Porta da API no host. Usada também pelo `make demo`.
API_HOST_PORT=8088
